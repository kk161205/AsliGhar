GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
PUBLIC_BASE_URL=http://localhost:8000
IMAGE_TTL_MINUTES=15
SCAN_CACHE_TTL_SECONDS=600
